# ── Generator + primary judge (same model, per spec §5.1) ────────────────────
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=none
MODEL_NAME=qwen2.5-coder:7b

# ── Secondary judge (dual-judge agreement / Cohen's kappa, bonus) ────────────
# Different model family → meaningful agreement signal.
SECONDARY_BASE_URL=http://localhost:11434/v1
SECONDARY_API_KEY=none
SECONDARY_MODEL=llama3.2:3b

# ── Eval settings ─────────────────────────────────────────────────────────────
CORRECTNESS_THRESHOLD=0.7
MAX_WORKERS=1              # increase to 4 when GPU has headroom
REQUEST_TIMEOUT_SEC=90
MAX_TOKENS_GENERATOR=512   # caps generator output; critical for CPU speed
MAX_TOKENS_JUDGE=200       # judge JSON is short (~80 tokens)
NUM_CTX=4096               # Ollama context window (default 2048 is too small)

# ── Path to cloned WinMerge repo (Src/ must exist inside) ────────────────────
WINMERGE_REPO_PATH=./winmerge

# ── Hybrid retrieval: BM25 + dense, RRF fusion (spec §1) ──────────────────────
USE_DENSE=1                                   # 0 → BM25-only
EMBEDDING_MODEL=intfloat/multilingual-e5-base # bge-m3 = higher quality, needs more compute
EMBEDDING_DEVICE=cpu                          # cpu avoids VRAM contention with Ollama
BM25_MIN_SCORE=15                             # BM25 joins fusion only on a real lexical match

# ── Set to 1 for mock responses (no real API calls) ──────────────────────────
DRY_RUN=0
